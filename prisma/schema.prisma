// AEVORA Production PostgreSQL Prisma Schema
// Note: Local runtime uses SQLite via src/server/db.ts for zero-dependency execution;
// deploy to Vercel + Managed PostgreSQL using `npx prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ELDERLY
  FAMILY
  CARETAKER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum DoseStatus {
  SCHEDULED
  TAKEN
  MISSED
  SKIPPED
  DELAYED
}

enum MedCategory {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  name                   String
  role                   UserRole
  status                 AccountStatus           @default(ACTIVE)
  avatarUrl              String?
  phone                  String?
  preferredLanguage      String                  @default("English")
  accessibleMode         Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  elderlyProfile         ElderlyProfile?
  careMemberships        CareCircleMember[]
  sentInvitations        Invitation[]            @relation("InvitedBy")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogs              AuditLog[]
}

model ElderlyProfile {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                  String
  dateOfBirth               String
  bloodType                 String?
  allergies                 String?
  medicalConditions         String?
  primaryDoctorName         String?
  primaryDoctorPhone        String?
  primaryDoctorClinic       String?
  importantNotes            String?
  preferredLanguage         String             @default("English")
  accessibilityLargeText    Boolean            @default(false)
  accessibilityHighContrast Boolean            @default(false)
  accessibilitySimplified   Boolean            @default(false)
  carePinHash               String?
  onboardingCompleted       Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  careCircle                CareCircle?
  medications               Medication[]
  doses                     MedicationDose[]
  logs                      MedicationLog[]
  appointments              Appointment[]
  careNotes                 CareNote[]
  careTasks                 CareTask[]
  careHandovers             CareHandover[]
  emergencyContacts         EmergencyContact[]
  medicalRecords            MedicalRecord[]
}

model CareCircle {
  id               String             @id @default(cuid())
  elderlyProfileId String             @unique
  elderlyProfile   ElderlyProfile     @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  name             String
  createdAt        DateTime           @default(now())
  members          CareCircleMember[]
  invitations      Invitation[]
}

model CareCircleMember {
  id               String            @id @default(cuid())
  careCircleId     String
  careCircle       CareCircle        @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRole       UserRole
  relationship     String?
  responsibilities String?
  status           String            @default("ACTIVE")
  joinedAt         DateTime          @default(now())
  permissions      AccessPermission?

  @@unique([careCircleId, userId])
}

model Invitation {
  id              String     @id @default(cuid())
  careCircleId    String
  careCircle      CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedBy       User       @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  email           String
  targetRole      UserRole
  relationship    String?
  code            String     @unique
  status          String     @default("PENDING")
  permissionsJson String?
  expiresAt       DateTime
  createdAt       DateTime   @default(now())
}

model AccessPermission {
  id                     String           @id @default(cuid())
  careCircleMemberId     String           @unique
  member                 CareCircleMember @relation(fields: [careCircleMemberId], references: [id], onDelete: Cascade)
  canViewMedications     Boolean          @default(true)
  canManageMedications   Boolean          @default(false)
  canConfirmDoses        Boolean          @default(true)
  canViewAppointments    Boolean          @default(true)
  canManageAppointments  Boolean          @default(false)
  canViewMedicalVault    Boolean          @default(false)
  canEditHealthProfile   Boolean          @default(false)
  canReceiveEscalations  Boolean          @default(true)
}

model Medication {
  id                String               @id @default(cuid())
  elderlyProfileId  String
  elderlyProfile    ElderlyProfile       @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  name              String
  dosage            String
  frequency         String
  category          MedCategory
  instructions      String?
  prescribingDoctor String?
  startDate         String
  endDate           String?
  refillDate        String?
  remainingUnits    Int                  @default(30)
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  schedules         MedicationSchedule[]
  doses             MedicationDose[]
  logs              MedicationLog[]
}

model MedicationSchedule {
  id           String           @id @default(cuid())
  medicationId String
  medication   Medication       @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  timeOfDay    String
  daysOfWeek   String           @default("DAILY")
  timezone     String           @default("America/Los_Angeles")
  doses        MedicationDose[]
}

model MedicationDose {
  id                String              @id @default(cuid())
  medicationId      String
  medication        Medication          @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  scheduleId        String?
  schedule          MedicationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  elderlyProfileId  String
  elderlyProfile    ElderlyProfile      @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  scheduledForDate  String
  scheduledTime     String
  status            DoseStatus          @default(SCHEDULED)
  confirmedByUserId String?
  confirmedByName   String?
  confirmedAt       DateTime?
  delayedUntil      String?
  notes             String?
  logs              MedicationLog[]

  @@unique([medicationId, scheduledForDate, scheduledTime])
  @@index([elderlyProfileId, scheduledForDate])
}

model MedicationLog {
  id               String         @id @default(cuid())
  doseId           String
  dose             MedicationDose @relation(fields: [doseId], references: [id], onDelete: Cascade)
  medicationId     String
  medication       Medication     @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  elderlyProfileId String
  elderlyProfile   ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  action           String
  previousStatus   String?
  newStatus        String
  actorUserId      String
  actorName        String
  details          String?
  createdAt        DateTime       @default(now())
}

model Appointment {
  id               String            @id @default(cuid())
  elderlyProfileId String
  elderlyProfile   ElderlyProfile    @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  doctorName       String
  specialty        String
  hospitalClinic   String
  appointmentDate  String
  appointmentTime  String
  address          String?
  contactNumber    String?
  reason           String
  notes            String?
  status           AppointmentStatus @default(UPCOMING)
  followUpDate     String?
  reminderSent     Boolean           @default(false)
  createdByUserId  String
  createdAt        DateTime          @default(now())
}

model CareNote {
  id               String         @id @default(cuid())
  elderlyProfileId String
  elderlyProfile   ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  authorUserId     String
  authorName       String
  authorRole       UserRole
  category         String
  title            String
  content          String
  isPinned         Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

model CareTask {
  id               String         @id @default(cuid())
  elderlyProfileId String
  elderlyProfile   ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  assignedToUserId String?
  assignedToName   String?
  createdByUserId  String
  title            String
  description      String?
  dueTime          String?
  status           String         @default("PENDING")
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
}

model CareHandover {
  id                    String         @id @default(cuid())
  elderlyProfileId      String
  elderlyProfile        ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  fromUserId            String
  fromName              String
  shiftLabel            String
  completedActivities   String
  pendingTasks          String
  observations          String
  nextShiftInstructions String
  acknowledgedByName    String?
  acknowledgedAt        DateTime?
  createdAt             DateTime       @default(now())
}

model Notification {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  elderlyProfileId String?
  type             String
  title            String
  message          String
  status           String     @default("UNREAD")
  channel          String     @default("IN_APP")
  relatedEntityKey String?
  createdAt        DateTime   @default(now())
  emailLogs        EmailLog[]

  @@unique([userId, relatedEntityKey])
}

model EmailLog {
  id             String        @id @default(cuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  recipientEmail String
  subject        String
  htmlPreview    String
  status         String
  providerId     String?
  errorMessage   String?
  retryCount     Int           @default(0)
  createdAt      DateTime      @default(now())
}

model NotificationPreference {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled          Boolean @default(true)
  reminderLeadMinutes   Int     @default(30)
  escalationGraceMinutes Int    @default(45)
  escalateToCaretaker   Boolean @default(true)
  escalateToFamily      Boolean @default(true)
  refillLeadDays        Int     @default(5)
  timezone              String  @default("America/Los_Angeles")
}

model EmergencyContact {
  id               String         @id @default(cuid())
  elderlyProfileId String
  elderlyProfile   ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  name             String
  relationship     String
  phone            String
  email            String?
  isPrimary        Boolean        @default(false)
  notes            String?
}

model MedicalRecord {
  id                String         @id @default(cuid())
  elderlyProfileId  String
  elderlyProfile    ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  title             String
  recordType        String
  fileName          String
  mimeType          String
  fileSize          Int
  contentSummary    String?
  fileDataUrl       String?
  restrictedToOwner Boolean        @default(false)
  uploadedByUserId  String
  uploadedByName    String
  createdAt         DateTime       @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail   String
  actorRole    String
  action       String
  resourceType String
  resourceId   String?
  details      String?
  createdAt    DateTime @default(now())
}

model WellnessCheckin {
  id               String         @id @default(cuid())
  elderlyProfileId String
  authorUserId     String
  authorName       String
  mood             String
  energyLevel      Int
  wellbeingNotes   String?
  createdAt        DateTime       @default(now())
}

model AiConversation {
  id               String   @id @default(cuid())
  userId           String
  elderlyProfileId String?
  role             String
  content          String
  language         String   @default("English")
  createdAt        DateTime @default(now())
}
