# GEMINI_API_KEY: Required for AEVORA Companion server-side Gemini AI calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret used to sign HTTP-only session cookies.
SESSION_SECRET="replace-with-a-long-random-secret"

# RESEND_API_KEY: Optional Resend API key for live transactional care emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AEVORA Care <care@notifications.aevora.health>"

# DATABASE_URL: PostgreSQL connection string for production Prisma deployment.
DATABASE_URL="postgresql://user:password@localhost:5432/aevora?schema=public"
